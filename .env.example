# Copy to .env to change settings. Everything here is OPTIONAL; Crysta runs with no .env at all.
# CRYSTA_HOST=127.0.0.1
# CRYSTA_PORT=8765
# CRYSTA_USER_NAME=Arshad
# CRYSTA_DATA_DIR=./data

# Local model via Ollama (free, runs on your laptop). Leave blank to auto-use the first installed model.
# CRYSTA_OLLAMA_URL=http://127.0.0.1:11434
# CRYSTA_OLLAMA_MODEL=

# Optional: any OpenAI-compatible server (LM Studio, llama.cpp server, or a cloud provider you choose).
# CRYSTA_OPENAI_BASE=http://127.0.0.1:1234/v1
# CRYSTA_OPENAI_MODEL=your-model-name
# CRYSTA_OPENAI_KEY=put-key-here-only-if-your-server-needs-one

# Optional HTTPS for --lan mode (see docs/DEVICE_PAIRING.md)
# CRYSTA_TLS_CERT=
# CRYSTA_TLS_KEY=
